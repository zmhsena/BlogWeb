:root {
    --color-paper: #f5f7f4;
    --color-surface: #ffffff;
    --color-ink: #17212b;
    --color-muted: #66737a;
    --color-line: #d8e0dc;
    --color-teal: #1f6f68;
    --color-teal-soft: #e5f0ed;
    --color-rust: #c56b4c;
    --color-code: #1d252b;
    --font-display: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
    --font-body: Inter, "PingFang SC", "Microsoft YaHei", sans-serif;
    --font-mono: "IBM Plex Mono", Consolas, monospace;
    --content-max: 1180px;
    --reading-max: 720px;
    --radius-small: 4px;
    --radius-medium: 8px;
    --shadow-soft: 0 12px 32px rgb(23 33 43 / 7%);
    --shadow-focus: 0 0 0 3px rgb(31 111 104 / 22%);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    text-rendering: optimizeLegibility;
}

img {
    max-width: 100%;
}

a {
    color: inherit;
}

button,
input,
textarea,
select {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

:focus-visible {
    outline: 3px solid var(--color-teal);
    outline-offset: 3px;
    box-shadow: var(--shadow-focus);
}

.skip-link {
    position: fixed;
    z-index: 2000;
    top: 12px;
    left: 12px;
    padding: 8px 12px;
    transform: translateY(-180%);
    background: var(--color-ink);
    color: var(--color-surface);
    font-weight: 700;
    text-decoration: none;
    transition: transform 160ms ease;
}

.skip-link:focus {
    transform: translateY(0);
}

.site-shell {
    width: min(var(--content-max), calc(100% - 40px));
    margin-inline: auto;
}

.site-header {
    border-bottom: 1px solid var(--color-line);
    background: rgb(245 247 244 / 94%);
    backdrop-filter: blur(12px);
}

.header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 800;
    text-decoration: none;
}

.brand-mark {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--color-teal);
    border-radius: 50%;
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
}

.brand-name {
    font-family: var(--font-display);
    font-size: 18px;
}

.primary-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 24px;
    color: var(--color-muted);
    font-size: 14px;
}

.primary-nav a {
    position: relative;
    padding: 6px 0;
    text-decoration: none;
}

.primary-nav a:not(.nav-action)::after,
.text-link::after,
.back-link::after,
.read-link::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: right;
    background: currentColor;
    content: "";
    transition: transform 180ms ease;
}

.primary-nav a:not(.nav-action):hover::after,
.primary-nav a:not(.nav-action):focus-visible::after,
.text-link:hover::after,
.text-link:focus-visible::after,
.back-link:hover::after,
.back-link:focus-visible::after,
.read-link:hover::after,
.read-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
}

.nav-action {
    border: 1px solid var(--color-teal);
    border-radius: var(--radius-small);
    padding: 7px 12px !important;
    color: var(--color-teal);
    font-weight: 700;
}

.nav-action:hover,
.nav-action:focus-visible {
    background: var(--color-teal);
    color: var(--color-surface);
}

.listing-main {
    padding-block: 76px 96px;
}

.listing-intro {
    max-width: 760px;
    padding-bottom: 70px;
}

.eyebrow,
.section-kicker,
.rail-label {
    margin: 0;
    color: var(--color-teal);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
}

.listing-intro h1 {
    max-width: 720px;
    margin: 18px 0 18px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.18;
}

.intro-copy {
    max-width: 580px;
    margin: 0;
    color: var(--color-muted);
    font-size: 18px;
}

.intro-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
}

.meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-rust);
}

.listing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 88px;
    align-items: start;
}

.notes-column,
.about-rail {
    min-width: 0;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 14px;
}

.section-heading h2,
.about-rail h2 {
    margin: 7px 0 0;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.3;
}

.count-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
}

.post-list {
    border-left: 2px solid var(--color-teal);
}

.post-list[data-state="loading"] {
    min-height: 160px;
}

.note-entry {
    position: relative;
    padding: 0 0 34px 30px;
}

.note-entry + .note-entry {
    padding-top: 34px;
    border-top: 1px solid var(--color-line);
}

.note-entry::before {
    position: absolute;
    top: 5px;
    left: -7px;
    width: 12px;
    height: 12px;
    border: 3px solid var(--color-paper);
    border-radius: 50%;
    background: var(--color-teal);
    content: "";
}

.note-entry + .note-entry::before {
    top: 39px;
}

.note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
}

.note-meta .category {
    color: var(--color-rust);
}

.note-entry h2 {
    max-width: 720px;
    margin: 9px 0 8px;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.35;
}

.note-entry h2 a {
    text-decoration: none;
}

.note-entry h2 a:hover,
.note-entry h2 a:focus-visible {
    color: var(--color-teal);
}

.note-excerpt {
    max-width: 680px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
}

.read-link,
.text-link,
.back-link {
    position: relative;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 7px;
    color: var(--color-teal);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
}

.read-link {
    margin-top: 14px;
}

.about-rail {
    position: sticky;
    top: 28px;
    padding-top: 4px;
    color: var(--color-muted);
}

.about-rule {
    width: 42px;
    height: 3px;
    margin-bottom: 24px;
    background: var(--color-rust);
}

.about-rail h2 {
    color: var(--color-ink);
    font-size: 23px;
}

.about-rail > p:not(.section-kicker) {
    margin: 18px 0 24px;
    font-size: 14px;
}

.about-facts {
    margin: 0 0 26px;
    border-top: 1px solid var(--color-line);
}

.about-facts div {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 12px;
}

.about-facts dt {
    color: var(--color-ink);
    font-family: var(--font-mono);
}

.about-facts dd {
    margin: 0;
}

.listing-status,
.article-status {
    min-height: 0;
}

.status {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 12px;
    align-items: baseline;
    margin: 0 0 20px;
    border-left: 3px solid var(--color-teal);
    padding: 10px 14px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 13px;
    overflow-wrap: anywhere;
}

.status strong {
    color: var(--color-ink);
}

.status p {
    flex-basis: 100%;
    margin: 0;
    overflow-wrap: anywhere;
}

.status--error {
    border-color: var(--color-rust);
}

.status--fallback {
    border-color: var(--color-rust);
}

.status--empty {
    border-color: var(--color-muted);
}

.loading-line {
    display: grid;
    gap: 14px;
    padding: 14px 30px;
}

.loading-line span {
    display: block;
    width: 86%;
    height: 10px;
    background: var(--color-line);
}

.loading-line span:nth-child(2) {
    width: 65%;
}

.loading-line span:nth-child(3) {
    width: 42%;
}

.site-footer {
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 22px;
}

.article-main {
    padding-block: 34px 90px;
}

.breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 58px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
}

.breadcrumb > span:last-child {
    color: var(--color-ink);
}

.article-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--reading-max)) 210px;
    gap: 86px;
    align-items: start;
    justify-content: center;
}

.article-shell {
    min-width: 0;
}

.article-header {
    margin-bottom: 42px;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 34px;
}

.article-header h1 {
    margin: 14px 0 16px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.22;
}

.article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
}

.article-meta .category {
    color: var(--color-rust);
}

.markdown-body {
    min-width: 0;
    color: var(--color-ink);
    font-size: 17px;
    line-height: 1.9;
}

.markdown-body > :first-child {
    margin-top: 0;
}

.markdown-body h2,
.markdown-body h3,
.markdown-body h4 {
    margin: 42px 0 14px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.35;
}

.markdown-body h2 {
    font-size: 30px;
}

.markdown-body h3 {
    font-size: 24px;
}

.markdown-body h4 {
    font-size: 20px;
}

.markdown-body p,
.markdown-body ul,
.markdown-body ol,
.markdown-body blockquote,
.markdown-body table {
    margin: 0 0 22px;
}

.markdown-body ul,
.markdown-body ol {
    padding-left: 1.5em;
}

.markdown-body li + li {
    margin-top: 6px;
}

.markdown-body a {
    color: var(--color-teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
}

.markdown-body blockquote {
    border-left: 3px solid var(--color-rust);
    padding: 4px 0 4px 20px;
    color: var(--color-muted);
}

.markdown-body hr {
    margin: 38px 0;
    border: 0;
    border-top: 1px solid var(--color-line);
}

.markdown-body img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 30px auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
}

.markdown-body pre {
    margin: 28px 0;
    overflow-x: auto;
    border-radius: var(--radius-small);
    padding: 20px;
    background: var(--color-code) !important;
    color: #d8e0dc;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    tab-size: 4;
}

.markdown-body code {
    font-family: var(--font-mono);
    font-size: 0.88em;
}

.markdown-body :not(pre) > code {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    padding: 2px 5px;
    background: var(--color-teal-soft);
    color: var(--color-teal);
}

.markdown-body table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
}

.markdown-body th,
.markdown-body td {
    border: 1px solid var(--color-line);
    padding: 8px 12px;
    text-align: left;
}

.markdown-body th {
    background: var(--color-teal-soft);
    color: var(--color-ink);
}

.article-rail {
    position: sticky;
    top: 32px;
    border-top: 3px solid var(--color-rust);
    padding-top: 18px;
    color: var(--color-muted);
    font-size: 13px;
}

.article-rail p {
    margin: 14px 0 0;
}

.article-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 58px;
    border-top: 1px solid var(--color-line);
    padding-top: 22px;
}

.top-button {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 13px;
}

.top-button:hover,
.top-button:focus-visible {
    color: var(--color-teal);
}

/* Admin workspace and compatibility styles. */
.admin-heading {
    max-width: 720px;
    margin-bottom: 40px;
}

.admin-heading h1 {
    margin: 12px 0 10px;
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 600;
    line-height: 1.2;
}

.admin-heading p:last-child {
    margin: 0;
    color: var(--color-muted);
}

.admin-section-heading,
.editor-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
}

.admin-section-heading h2,
.editor-heading h2 {
    margin: 7px 0 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
}

.admin-section-heading > [aria-live] {
    max-width: 70%;
}

.field-group {
    margin-top: 18px;
}

.field-group > label,
.token-section > label {
    display: block;
    margin-bottom: 7px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 700;
}

.field-help {
    margin: 8px 0 0;
    color: var(--color-muted);
    font-size: 12px;
}

.secondary-button {
    border-color: var(--color-line) !important;
    background: var(--color-surface) !important;
    color: var(--color-ink) !important;
}

.secondary-button:hover,
.secondary-button:focus-visible {
    border-color: var(--color-teal) !important;
    background: var(--color-teal-soft) !important;
    color: var(--color-teal) !important;
}

.admin-item-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
}

.admin-item-copy strong {
    overflow-wrap: anywhere;
    font-size: 14px;
}

.admin-item-copy small {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
}

.admin-item-actions {
    display: flex;
    flex-shrink: 0;
    gap: 6px;
}

.admin-item-actions .danger-button {
    border-color: var(--color-rust);
    background: var(--color-rust);
}

.editor-content-group textarea.is-dragging {
    border-color: var(--color-teal);
    background: var(--color-teal-soft);
}

.form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.form-actions button {
    min-height: 42px;
}

.color-option {
    display: block;
    border: 0;
    background: var(--swatch, var(--color-teal));
}

.color-option.swatch-rust { --swatch: #c56b4c; }
.color-option.swatch-teal { --swatch: #1f6f68; }
.color-option.swatch-blue { --swatch: #2f6f9f; }
.color-option.swatch-gold { --swatch: #8a6d1d; }

.admin-container {
    width: min(var(--content-max), calc(100% - 40px));
    margin: 0 auto;
    padding: 52px 0 80px;
}

.admin-container h2,
.admin-container h3,
.admin-container h4 {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 600;
}

.admin-container > h2 {
    margin: 0 0 28px;
    font-size: 36px;
}

.token-section,
.edit-area,
.edit-section {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
}

.token-section {
    margin-bottom: 26px;
    padding: 20px;
}

.token-section h4 {
    margin: 0 0 12px;
    font-size: 17px;
}

.token-input-group {
    display: flex;
    gap: 10px;
    align-items: center;
}

#token-input,
.admin-container input,
.admin-container textarea,
.admin-container select {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    padding: 9px 12px;
    background: var(--color-surface);
    color: var(--color-ink);
}

.admin-container textarea {
    min-height: 320px;
    resize: vertical;
    font-family: var(--font-mono);
    line-height: 1.65;
}

.admin-main {
    display: flex;
    gap: 28px;
    max-width: none;
    margin: 0 0 28px;
    padding: 0;
}

.list-section {
    flex: 1;
    min-width: 280px;
}

.edit-section {
    position: sticky;
    top: 24px;
    flex: 1.4;
    min-width: 0;
    height: fit-content;
    padding: 20px;
}

.scroll-window {
    height: 470px;
    overflow-y: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    background: var(--color-surface);
}

.admin-item,
.post-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 14px;
    border-bottom: 1px solid var(--color-line);
}

.admin-item:last-child,
.post-item:last-child {
    border-bottom: 0;
}

.admin-item span,
.post-item > span {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-ink);
    line-height: 1.45;
}

.admin-item button,
.post-item button,
.admin-container button {
    border: 1px solid var(--color-teal);
    border-radius: var(--radius-small);
    padding: 8px 12px;
    background: var(--color-teal);
    color: var(--color-surface);
    cursor: pointer;
    font-size: 13px;
    font-weight: 700;
}

.admin-container button:hover {
    background: #195c56;
}

.admin-container button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

.edit-area {
    padding: 24px;
}

.edit-area h3 {
    margin: 0 0 18px;
    font-size: 24px;
}

.toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
    border: 1px solid var(--color-line);
    border-bottom: 0;
    border-radius: var(--radius-small) var(--radius-small) 0 0;
    padding: 8px;
    background: var(--color-paper);
}

.toolbar button {
    min-width: 34px;
    min-height: 34px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 5px 10px;
}

.toolbar button:hover {
    border-color: var(--color-teal);
    background: var(--color-teal-soft);
    color: var(--color-teal);
}

#post-content {
    margin-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.editor-container {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
}

.editor-input,
.editor-preview {
    flex: 1;
    min-width: 0;
}

.editor-preview {
    height: 500px;
    overflow-y: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-small);
    padding: 16px;
    background: var(--color-surface);
}

.preview-label {
    margin-bottom: 12px;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 8px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.color-dropdown {
    position: relative;
}

.color-menu {
    position: absolute;
    z-index: 10;
    top: calc(100% + 4px);
    left: 0;
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    border: 1px solid var(--color-line);
    padding: 6px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
}

.color-dropdown:hover .color-menu,
.color-dropdown:focus-within .color-menu {
    display: grid;
}

.color-option {
    width: 25px;
    height: 25px;
    border: 1px solid rgb(23 33 43 / 20%);
    border-radius: var(--radius-small);
    cursor: pointer;
}

@media (max-width: 900px) {
    .listing-grid {
        grid-template-columns: minmax(0, 1fr) 230px;
        gap: 44px;
    }

    .article-layout {
        grid-template-columns: minmax(0, var(--reading-max));
    }

    .article-rail {
        display: none;
    }

    .admin-main {
        flex-direction: column;
    }

    .edit-section {
        position: static;
    }
}

@media (max-width: 760px) {
    .site-shell,
    .admin-container {
        width: calc(100% - 32px);
    }

    .header-inner {
        flex-wrap: wrap;
        min-height: 68px;
        row-gap: 8px;
    }

    .brand-name {
        font-size: 16px;
    }

    .primary-nav {
        margin-left: auto;
        gap: 12px;
        font-size: 12px;
    }

    .primary-nav a:nth-child(2) {
        display: none;
    }

    .nav-action {
        padding: 6px 8px !important;
    }

    .listing-main {
        padding-block: 48px 64px;
    }

    .listing-intro {
        padding-bottom: 52px;
    }

    .listing-intro h1 {
        font-size: 36px;
        overflow-wrap: anywhere;
    }

    .intro-copy {
        font-size: 16px;
    }

    .listing-grid {
        grid-template-columns: 1fr;
        gap: 56px;
    }

    .about-rail {
        position: static;
        border-top: 1px solid var(--color-line);
        padding-top: 28px;
    }

    .section-heading h2 {
        font-size: 24px;
    }

    .note-entry {
        padding-left: 22px;
    }

    .note-entry h2 {
        font-size: 23px;
    }

    .footer-inner {
        flex-direction: column;
        gap: 4px;
    }

    .article-main {
        padding-block: 24px 64px;
    }

    .breadcrumb {
        margin-bottom: 40px;
    }

    .article-header {
        margin-bottom: 32px;
        padding-bottom: 24px;
    }

    .article-header h1 {
        font-size: 34px;
    }

    .markdown-body {
        font-size: 16px;
    }

    .markdown-body h2 {
        font-size: 26px;
    }

    .markdown-body h3 {
        font-size: 22px;
    }

    .article-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    .token-input-group,
    .editor-container {
        flex-direction: column;
        align-items: stretch;
    }

    .editor-preview {
        height: 360px;
    }

    .scroll-window {
        height: 320px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}
